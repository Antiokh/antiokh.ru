---
import { experience, type ExperienceLocale } from '../../data/experience';
const { lang } = Astro.props as { lang: ExperienceLocale };
const content = experience[lang];
---
<section id="experience" class="experience-section wrap">
  <div class="experience-head">
    <span class="section-label">{content.label}</span>
    <div>
      <h2>{content.title}</h2>
      <p>{content.intro}</p>
    </div>
  </div>

  <div class="experience-list">
    {content.items.map((item, index) => (
      <details class="experience-item" open={index === 0}>
        <summary>
          <span class="experience-number">{String(index + 1).padStart(2, '0')}</span>
          <span class="experience-date">{item.date}</span>
          <span class="experience-summary-main">
            <strong>{item.organization}</strong>
            <span>{item.role}</span>
          </span>
          <span class="experience-toggle" aria-hidden="true"></span>
        </summary>
        <div class="experience-body">
          <p class="experience-lead">{item.summary}</p>
          <div class="experience-prose">
            {item.paragraphs.map(paragraph => <p>{paragraph}</p>)}
          </div>
          <div class="experience-detail-grid">
            <div>
              <h3>{content.responsibilitiesLabel}</h3>
              <ul>{item.responsibilities.map(point => <li>{point}</li>)}</ul>
            </div>
            {item.technologies?.length && (
              <div class="experience-tech">
                <h3>{content.technologiesLabel}</h3>
                <p>{item.technologies.join(' · ')}</p>
              </div>
            )}
          </div>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .experience-section { padding-top: 40px; padding-bottom: 140px; }
  .experience-head { display: grid; grid-template-columns: minmax(220px, .52fr) minmax(0, 1fr); gap: 8%; align-items: start; margin-bottom: 58px; }
  .experience-head h2 { margin: 0; max-width: 850px; font: 500 clamp(42px, 5vw, 70px)/1 var(--serif); letter-spacing: -.04em; }
  .experience-head p { max-width: 780px; margin: 28px 0 0; color: var(--muted); font-size: 16px; line-height: 1.72; }
  .experience-list { border-top: 1px solid var(--line); }
  .experience-item { border-bottom: 1px solid var(--line); }
  .experience-item summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: 54px 190px minmax(0, 1fr) 34px; gap: 20px; align-items: start; padding: 30px 0; }
  .experience-item summary::-webkit-details-marker { display: none; }
  .experience-item summary:focus-visible { outline: 3px solid var(--rust); outline-offset: 5px; }
  .experience-number { padding-top: 4px; color: var(--rust); font-size: 10px; letter-spacing: .12em; }
  .experience-date { padding-top: 2px; font: 500 17px/1.4 var(--serif); }
  .experience-summary-main { display: block; }
  .experience-summary-main strong { display: block; font: 500 clamp(24px, 2.5vw, 34px)/1.18 var(--serif); letter-spacing: -.018em; }
  .experience-summary-main > span { display: block; margin-top: 8px; color: var(--muted); font-size: 12px; line-height: 1.5; }
  .experience-toggle { width: 28px; height: 28px; position: relative; margin-top: 2px; border: 1px solid var(--line); border-radius: 50%; }
  .experience-toggle::before, .experience-toggle::after { content: ''; position: absolute; background: currentColor; left: 7px; right: 7px; top: 13px; height: 1px; }
  .experience-toggle::after { transform: rotate(90deg); transition: transform .2s ease; }
  details[open] .experience-toggle::after { transform: rotate(0); }
  .experience-body { margin-left: 264px; max-width: 900px; padding: 0 0 48px; }
  .experience-lead { margin: 0 0 26px; font: 400 clamp(22px, 2.3vw, 29px)/1.42 var(--serif); }
  .experience-prose { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px; }
  .experience-prose p { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.78; }
  .experience-detail-grid { display: grid; grid-template-columns: 1.4fr .8fr; gap: 50px; margin-top: 34px; padding-top: 30px; border-top: 1px solid var(--line); }
  .experience-detail-grid h3 { margin: 0 0 16px; font-size: 10px; text-transform: uppercase; letter-spacing: .15em; }
  .experience-detail-grid ul { margin: 0; padding-left: 18px; }
  .experience-detail-grid li { margin: 0 0 8px; color: var(--muted); font-size: 14px; line-height: 1.6; }
  .experience-tech p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.75; }

  @media (max-width: 850px) {
    .experience-section { padding-bottom: 90px; }
    .experience-head { grid-template-columns: 1fr; gap: 20px; }
    .experience-item summary { grid-template-columns: 38px minmax(0, 1fr) 30px; gap: 14px; }
    .experience-date { grid-column: 2; grid-row: 2; font-size: 14px; color: var(--muted); }
    .experience-summary-main { grid-column: 2; grid-row: 1; }
    .experience-toggle { grid-column: 3; grid-row: 1; }
    .experience-number { grid-column: 1; grid-row: 1; }
    .experience-body { margin-left: 52px; }
    .experience-prose, .experience-detail-grid { grid-template-columns: 1fr; gap: 22px; }
  }

  @media (max-width: 560px) {
    .experience-item summary { padding: 24px 0; }
    .experience-body { margin-left: 0; padding-bottom: 38px; }
    .experience-summary-main strong { font-size: 24px; }
  }
</style>
