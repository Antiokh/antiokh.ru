---
import type { HomeContent } from '../../data/home';
const { content } = Astro.props as { content: HomeContent };
const h = content.hero;
---
<section class="portrait-hero wrap"><div class="portrait-copy"><div class="eyebrow"><span class="status-dot"></span> {h.eyebrow}</div><p class="hello">{h.intro}</p><h1>{h.name.split('\n').map((line)=><>{line}<br /></>)}</h1><p class="hero-role">{h.role}</p><div class="hero-actions"><a class="button solid" href="#story">{h.storyCta}</a><a class="text-link" href="#portfolio">{h.casesCta}</a></div></div><figure class="portrait"><img src="/portraits/anton-nazarov-belgrade.jpg" width="3648" height="5472" alt={content.lang === 'ru' ? 'Антон Владиславович Назаров у здания Народного банка в Белграде' : 'Anton Vladislavovich Nazarov outside the National Bank building in Belgrade'} fetchpriority="high" /><figcaption><span>Antiokh</span><span>{h.photoNote}</span></figcaption></figure></section>
