---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  lang?: 'ru' | 'en';
}

const { title, description, path = '/', lang = 'ru' } = Astro.props;
const canonical = new URL(path, Astro.site);
const ruPath = lang === 'ru' ? path : path.replace(/^\/en(?=\/|$)/, '') || '/';
const enPath = lang === 'en' ? path : path === '/' ? '/en/' : `/en${path}`;
const homePath = lang === 'ru' ? '/' : '/en/';
const aboutPath = lang === 'ru' ? '/about/' : '/en/about/';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://antiokh.ru/#anton-nazarov',
      name: lang === 'ru' ? 'Антон Владиславович Назаров' : 'Anton Vladislavovich Nazarov',
      alternateName: ['Anton Vladislavovich Nazarov', 'Антон Назаров', 'Anton Nazarov', 'Antiokh'],
      url: 'https://antiokh.ru/',
      image: 'https://antiokh.ru/og-image.png',
      jobTitle: ['Technology Leader', 'IT Manager', 'Systems Architect', 'CTO'],
      description: lang === 'ru'
        ? 'Технологический руководитель и системный архитектор из Белграда. Профессионально в IT с 2008 года: enterprise, банковские и государственные системы, Head of IT, собственные продукты и NeedleBit.'
        : 'Technology leader and systems architect based in Belgrade. Working professionally in IT since 2008 across enterprise, banking, public-sector systems, IT leadership, independent products, and NeedleBit.',
      homeLocation: { '@type': 'Place', name: 'Belgrade, Serbia' },
      knowsLanguage: ['ru', 'en', 'sr'],
      sameAs: [
        'https://github.com/Antiokh',
        'https://www.linkedin.com/in/nazarovanton/'
      ],
      worksFor: { '@type': 'Organization', name: 'NeedleBit' },
      knowsAbout: ['Engineering management', 'Systems architecture', 'Product delivery', 'Business process automation', 'AI-assisted development', 'Supabase', 'PostgreSQL']
    },
    {
      '@type': 'WebSite',
      '@id': 'https://antiokh.ru/#website',
      url: 'https://antiokh.ru/',
      name: lang === 'ru' ? 'Антон Назаров (Antiokh) — личный сайт' : 'Anton Nazarov (Antiokh) — personal website',
      inLanguage: lang,
      about: { '@id': 'https://antiokh.ru/#anton-nazarov' }
    }
  ]
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#171914" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://antiokh.ru/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="ru" href={new URL(ruPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(ruPath, Astro.site)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={homePath} aria-label={lang === 'ru' ? 'Антон Назаров — на главную' : 'Anton Nazarov — home'}>
        <span>A</span>
        <span class="wordmark-text">Antiokh <small>/ Anton Nazarov</small></span>
      </a>
      <nav aria-label={lang === 'ru' ? 'Основная навигация' : 'Main navigation'}>
        <a href={`${homePath}#story`}>{lang === 'ru' ? 'Путь' : 'Path'}</a>
        <a href={`${homePath}#portfolio`}>{lang === 'ru' ? 'Проекты' : 'Projects'}</a>
        <a href={`${homePath}#personal`}>{lang === 'ru' ? 'Вне работы' : 'Beyond work'}</a>
        <a href={aboutPath}>{lang === 'ru' ? 'Обо мне' : 'About'}</a>
      </nav>
      <a class="lang-switch" href={lang === 'ru' ? enPath : ruPath} hreflang={lang === 'ru' ? 'en' : 'ru'}>{lang === 'ru' ? 'EN' : 'RU'}</a>
      <a class="header-cta" href="mailto:mail@antiokh.ru">{lang === 'ru' ? 'Написать' : 'Write to me'} ↗</a>
    </header>
    <main><slot /></main>
    <footer>
      <div>
        <strong>{lang === 'ru' ? 'Антон Владиславович Назаров' : 'Anton Vladislavovich Nazarov'}</strong>
        <p>Antiokh · Belgrade · systems / people / products</p>
      </div>
      <div class="footer-links">
        <a href="https://github.com/Antiokh">GitHub</a>
        <a href="https://www.linkedin.com/in/nazarovanton/">LinkedIn</a>
        <a href="https://t.me/antiokh">Telegram</a>
        <a href="mailto:mail@antiokh.ru">Email</a>
      </div>
      <p class="fineprint">© {new Date().getFullYear()} · {lang === 'ru' ? 'Белград, Сербия' : 'Belgrade, Serbia'}</p>
    </footer>
  </body>
</html>
