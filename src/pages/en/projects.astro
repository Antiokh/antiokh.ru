---
import BaseLayout from '../../layouts/BaseLayout.astro';

const cases = [
  {
    id: 'mosrazvitie', n: '01', title: 'AIS MosRazvitie', type: 'GovTech · 100+ institutions', role: 'Architect · Analyst · Developer · Adoption', image: '/projects/mosrazvitie.png',
    text: 'A live IBM Domino platform for the Directorate of Cultural Centers and a network of 100+ institutions. My work covered data modeling, terminology, permissions, reporting, security, user training, servers, and daily operations.',
    facts: ['100+ institutions', 'Reporting, moderation, and external exchange', 'IBM Domino / XPages / JavaScript / XML']
  },
  {
    id: 'andronyevskaya', n: '02', title: 'Andronyevskaya ERP', type: 'Property operations · self-hosted', role: 'Developer · DevOps · Project Manager', image: '/projects/andronyevskaya.png',
    text: 'An ERP for property technical support where the digital workflow starts with physical equipment. A technician scans a QR code, opens the asset and task, talks to a manager, and completes the job while administrators manage sites, roles, and access.',
    facts: ['WeWeb + Supabase', 'Telegram Mini App and Bot API', 'Self-hosted backend and Edge Functions']
  },
  {
    id: 'exit-lead', n: '03', title: 'Exit Lead', type: 'Field inspections · documents', role: 'Builder · Architect · Designer', image: '/projects/exitlead.png',
    text: 'A field system for inspectors and a client portal on one backend. The workflow included routes, forms, photos, measurement-device data, automated PDFs, and a separate migration of roughly 70,000 historical reports from Google Drive into Supabase.',
    facts: ['Glide + WeWeb', 'Supabase + n8n + DocsAutomator', '~70,000 historical reports']
  },
  {
    id: 'metafox', n: '04', title: 'MetaFox Strengths Explorer', type: 'Assessment · evolving methodology', role: 'Product Owner · Full-stack Builder', image: '/projects/metafox.png',
    text: 'The methodology changed while the product was being built: the questionnaire grew, peer feedback was added, and interpretation rules became more sophisticated. I translated that moving model into a product with stable scoring, normalization, admin tooling, and PDF reports.',
    facts: ['64 questions', 'Peer feedback and deterministic scoring', 'WeWeb + Xano']
  },
  {
    id: 'promptlesspress', n: '05', title: 'PromptlessPress', type: 'AI product · generation workflows', role: 'Builder · Architect · AI Workflow Designer', image: '/projects/promptlesspress.png',
    text: 'A platform for generating digital products with AI. The central engineering problem is making a non-deterministic process manageable: persisted generation state, iterative refinement, clear intent/execution/asset boundaries, and auditable SQL logic in git.',
    facts: ['Supabase + WeWeb', 'OpenAI + fal.ai', 'Structured prompts, debug flow, and agent guardrails']
  }
];

const clientWork = [
  {
    title: 'Vencer Autismo', href: 'https://github.com/Antiokh/CV/tree/main/portfolio/vencer_autismo',
    text: 'A full assessment and recommendation platform with multi-level tests, weighted scoring, normalized results, radar charts, longitudinal history, and recommendations tied to score ranges. WeWeb + Supabase/PostgreSQL.'
  },
  {
    title: 'French Plumbers ERP', href: 'https://github.com/Antiokh/CV/tree/main/portfolio/french_plumbers_erp',
    text: 'An internal ERP for a French trade-services business covering operational workflows, employee interfaces, backend logic, and file management. Full-stack delivery with WeWeb and Supabase.'
  },
  {
    title: 'Educate Online', href: 'https://github.com/Antiokh/CV/tree/main/portfolio/educate_online',
    text: 'A corporate testing and employee-opinion platform with multilingual support, large-volume calculations, result visualization, and external logic to work around Bubble limitations. A working version was delivered in roughly three weeks.'
  },
  {
    title: 'Dobri Visarun', href: 'https://github.com/Antiokh/CV/tree/main/portfolio/dobri_visarun',
    text: 'A visa-run PWA replacing scattered Facebook, email, and messenger requests with structured registration, trips, and Telegram notifications. Revenue grew roughly 10× in about three months without advertising while manual client handling dropped sharply.'
  },
  {
    title: 'Dobri Tours', href: 'https://github.com/Antiokh/CV/tree/main/portfolio/dobri_tours',
    text: 'A tour catalog with booking, pricing, ratings, reviews, agent workflows, and loyalty mechanics. The work covered both the user-facing product and the operating model behind repeat sales.'
  },
  {
    title: 'QR Cloud', href: 'https://github.com/Antiokh/CV/tree/main/portfolio/qr_cloud',
    text: 'A mobile-first digital business-card and company-profile platform with public pages, QR access, social and messenger links, and shareable branded employee profiles.'
  },
  {
    title: 'Cashdesk Accounting', href: 'https://github.com/Antiokh/CV/tree/main/portfolio/cashdesk_bubble',
    text: 'A rebuild of an internal cash-desk and financial operations tool: cashier, auditor, and admin roles, income and costs, currency conversion, CSV exports, and security improvements.'
  },
  {
    title: 'MommyHana MBO', href: 'https://github.com/Antiokh/CV/tree/main/portfolio/mommy_hana',
    text: 'A sales and bonus-management system with WooCommerce integration, client and operations surfaces, and complex recursive commission logic. WeWeb + Supabase/PostgreSQL + WordPress webhooks.'
  }
];

const githubProjects = [
  {
    title: 'humanizer_russian', href: 'https://github.com/Antiokh/humanizer_russian', stack: 'Python · CLI · rule-based linting',
    text: 'A Russian-language editor and humanizer built around a mechanical-first approach: reliably testable language and editing patterns are caught in code, while context-sensitive review is reserved for cases where mechanics are insufficient.'
  },
  {
    title: 'rslive_content', href: 'https://github.com/Antiokh/rslive_content', stack: 'Astro · MDX · GitHub Actions · Cloudflare Pages',
    text: 'The content source of truth for RSLive, a structured Serbia relocation and life encyclopedia with MDX content, semantic indexing, fact-checking rules, and automated publishing.'
  },
  {
    title: 'postgres-to-accdb', href: 'https://github.com/Antiokh/postgres-to-accdb', stack: 'Python · PostgreSQL · SQLAlchemy · pyodbc · pandas',
    text: 'A PostgreSQL export bridge producing Access .accdb or SPSS .sav files, including a path for Tableau Public: streaming export, type conversion, indexes, and parameterized SQL.'
  },
  {
    title: 'antiokh.ru', href: 'https://github.com/Antiokh/antiokh.ru', stack: 'Astro · TypeScript · Cloudflare',
    text: 'This site is public too: a static multilingual personal profile with structured data, sitemap generation, LLM-readable files, and content grounded in source repositories.'
  },
  {
    title: 'ww-google-recaptcha-v3', href: 'https://github.com/Antiokh/ww-google-recaptcha-v3', stack: 'Vue · WeWeb · Google reCAPTCHA v3',
    text: 'A public custom WeWeb component for Google reCAPTCHA v3 integration.'
  },
  {
    title: 'dokuwiki-plugin-uplatnica', href: 'https://github.com/Antiokh/dokuwiki-plugin-uplatnica', stack: 'PHP · DokuWiki',
    text: 'A DokuWiki plugin for rendering Serbian payment slips (uplatnica).'
  }
];

const archive = [
  'Serbia Networking — offline networking application',
  'RuskaJela — local home-food marketplace',
  'Sefcast — SEO analytics interface',
  'Business Directory — mobile organization catalog',
  'Space AI — interactive AI prototype',
  'tgs.py — Telegram data tools',
  'MakeMeLook — visual product service',
  'Flower Shop — CRM and customer workflow'
];
---
<BaseLayout
  lang="en"
  path="/en/projects/"
  title="Anton Nazarov projects — freelance systems, open source, and pet projects"
  description="Projects by Anton Nazarov (Antiokh): client ERP and internal systems, GovTech, AI, automation, freelance delivery, open-source work, and public GitHub projects."
>
  <section class="page-hero wrap">
    <span class="section-label">Projects / client work, independent products, open source</span>
    <h1>Systems for clients.<br />Products of my own. <em>Code on GitHub.</em></h1>
    <p>Three lines of work meet here: large systems from employment, client delivery, and things I build because I need the tool myself or want to test an idea. They prove different things, so I do not pretend they are one homogeneous portfolio.</p>
  </section>

  <section class="case-list wrap">
    {cases.map(item =>
      <article class="case" id={item.id}>
        <div class="case-top"><span>{item.n}</span><span>{item.type}</span><span>{item.role}</span></div>
        <div class="case-body">
          <div><h2>{item.title}</h2><p>{item.text}</p><ul>{item.facts.map(f => <li>{f}</li>)}</ul></div>
          <img src={item.image} alt={`${item.title} interface`} loading="lazy" />
        </div>
      </article>
    )}
  </section>

  <section class="project-index wrap">
    <span class="section-label">Freelance and client delivery</span>
    <div class="project-index-head">
      <h2>Projects where I owned the working result.</h2>
      <p>In freelance work my role is often wider than “developer”: I have to reconstruct the process, design data and permissions, build the interface and backend, connect automation, release the product, and leave enough context for the next person to continue it.</p>
    </div>
    <div class="project-grid">
      {clientWork.map(item => <article class="project-card"><h3><a href={item.href}>{item.title} ↗</a></h3><p>{item.text}</p></article>)}
    </div>
  </section>

  <section class="project-index project-index-alt wrap">
    <span class="section-label">GitHub / open source and pet projects</span>
    <div class="project-index-head">
      <h2>I write code when there is no client too.</h2>
      <p>Public repositories show things a resume cannot prove very well: how I structure a project, document decisions, build tools for my own problems, and turn a small technical idea into something another person can inspect or use.</p>
    </div>
    <div class="repo-grid">
      {githubProjects.map(item => <article class="repo-card"><p class="repo-stack">{item.stack}</p><h3><a href={item.href}>{item.title} ↗</a></h3><p>{item.text}</p></article>)}
    </div>
  </section>

  <section class="archive wrap">
    <span class="section-label">More projects</span>
    <h2>Not everything needs a long case study.</h2>
    <div class="archive-grid">
      {archive.map((name, i) => <article><span>{String(i + 1).padStart(2, '0')}</span><h3>{name}</h3></article>)}
    </div>
  </section>
</BaseLayout>

<style>
  .project-index { padding-top: 125px; padding-bottom: 125px; border-top: 1px solid var(--line); }
  .project-index-alt { background: var(--paper-2); width: 100%; max-width: none; padding-left: max(44px, calc((100vw - 1280px) / 2 + 44px)); padding-right: max(44px, calc((100vw - 1280px) / 2 + 44px)); }
  .project-index-head { display: grid; grid-template-columns: 1fr .8fr; gap: 8%; margin: 26px 0 58px; }
  .project-index-head h2 { margin: 0; font: 500 clamp(38px, 4.5vw, 62px)/1.05 var(--serif); letter-spacing: -.035em; }
  .project-index-head p { margin: 7px 0 0; color: var(--muted); line-height: 1.72; }
  .project-grid, .repo-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .project-card, .repo-card { padding: 28px 30px 32px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .project-card h3, .repo-card h3 { margin: 0 0 16px; font: 500 27px/1.18 var(--serif); }
  .project-card h3 a:hover, .repo-card h3 a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .project-card > p, .repo-card > p:not(.repo-stack) { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.7; }
  .repo-stack { margin: 0 0 14px; color: var(--rust); font-size: 10px; line-height: 1.5; text-transform: uppercase; letter-spacing: .09em; }
  @media (max-width: 760px) {
    .project-index, .project-index-alt { padding-top: 80px; padding-bottom: 80px; }
    .project-index-alt { padding-left: 24px; padding-right: 24px; }
    .project-index-head, .project-grid, .repo-grid { grid-template-columns: 1fr; }
  }
</style>
