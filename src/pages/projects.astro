---
import BaseLayout from '../layouts/BaseLayout.astro';
const cases = [
  { id:'andronyevskaya', n:'01', title:'Andronyevskaya ERP', type:'Property operations', role:'Developer · DevOps · PM', image:'/projects/andronyevskaya.png', text:'Self-hosted ERP для технической эксплуатации недвижимости: QR-доступ к оборудованию, задания, три ролевых контура, Telegram Mini App и realtime-коммуникация.', facts:['WeWeb + Supabase','Telegram auth и уведомления','Self-hosted Edge Functions'] },
  { id:'mosrazvitie', n:'02', title:'AIS MosRazvitie', type:'GovTech · reporting', role:'Owner · Architect · Builder', image:'/projects/mosrazvitie.png', text:'Центральная операционная и отчётная система для дирекции и сети из 100+ учреждений. От модели данных и безопасности до обучения пользователей и эксплуатации.', facts:['100+ учреждений','Отчётность и модерация','IBM Domino / XPages'] },
  { id:'promptlesspress', n:'03', title:'PromptlessPress', type:'AI product platform', role:'Architect · AI workflow designer', image:'/projects/promptlesspress.png', text:'Платформа генерации готовых цифровых продуктов с воспроизводимым состоянием, итеративной AI-генерацией, mockup-конвейером и инженерными guardrails.', facts:['OpenAI + fal.ai','SQL-driven composition','AI-agent guardrails'] },
  { id:'metafox', n:'04', title:'MetaFox Strengths Explorer', type:'Assessment platform', role:'Product owner · Builder', image:'/projects/metafox.png', text:'Перевёл развивающуюся психометрическую методику в устойчивый цифровой продукт со scoring logic, peer feedback и визуальными PDF-отчётами.', facts:['64 вопроса','Нормализация результатов','WeWeb + Xano'] },
  { id:'exit-lead', n:'05', title:'Exit Lead', type:'Field operations', role:'Builder · Architect · Designer', image:'/projects/exitlead.png', text:'Две связанные поверхности для инспекторов и клиентов, автоматические PDF-отчёты, импорт данных измерительных приборов и миграция около 70 000 документов.', facts:['Glide + WeWeb','Supabase + n8n','≈70 000 отчётов'] }
];
---
<BaseLayout title="Проекты Антона Назарова — архитектура, продукты, автоматизация" description="Кейсы Антона Назарова: ERP, GovTech, AI-продукты, assessment и field operations. Роли, архитектура, решения и измеримый результат." path="/projects/">
  <section class="page-hero wrap"><span class="section-label">Портфолио / 01—05</span><h1>Сложность —<br /><em>мой рабочий материал.</em></h1><p>От отраслевых систем и legacy до AI-продуктов. Здесь важны не красивые экраны сами по себе, а контекст, архитектура и внедрение.</p></section>
  <section class="case-list wrap">{cases.map((item) => <article class="case" id={item.id}><div class="case-top"><span>{item.n}</span><span>{item.type}</span><span>{item.role}</span></div><div class="case-body"><div><h2>{item.title}</h2><p>{item.text}</p><ul>{item.facts.map(f => <li>{f}</li>)}</ul></div><img src={item.image} alt={`Скриншот ${item.title}`} loading="lazy" /></div></article>)}</section>
  <section class="archive wrap"><span class="section-label">Архив / ещё 16 проектов</span><h2>Остальная работа —<br />не менее настоящая.</h2><div class="archive-grid">{['Dobri Tours — приложения для экскурсий и визаранов','Educate Online — корпоративная система тестирования','Vencer Autismo — assessment для семей и специалистов','PromptlessPress — AI-генерация цифровых товаров','QR Cloud — управление динамическими QR-кодами','Cashdesk — внутренний финансовый учёт','French Plumbers ERP — выездные работы и диспетчеризация','RuskaJela — каталог и доставка локальных продуктов','Serbia Networking — профессиональное сообщество','Sefcast — SEO goal builder','MommyHana MBO — личный кабинет и операционная панель','Business Directory — мобильный каталог организаций','Space AI — интерактивный AI-прототип','tgs.py — Telegram data toolkit','MakeMeLook — визуальный продуктовый сервис','Flower Shop — CRM и клиентский workflow'].map((name,i)=><article><span>{String(i+6).padStart(2,'0')}</span><h3>{name}</h3></article>)}</div></section>
</BaseLayout>
